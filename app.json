{
  "expo": {
    "name": "Plantule",
    "slug": "plantule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plantule",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.lxwiq.plantule",
      "adaptiveIcon": {
        "backgroundColor": "#B4F1BD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6FBF3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1510",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "./plugins/with-android-release-signing",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2E6B3E"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Plantule utilise l’appareil photo pour photographier tes plantes.",
          "photosPermission": "Plantule accède à tes photos pour illustrer tes plantes.",
          "microphonePermission": false
        }
      ],
      "react-native-litert-lm"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
